generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String                 @id @default(uuid()) @db.Uuid
  githubId     String                 @unique @map("github_id")
  username     String
  avatarUrl    String?                @map("avatar_url")
  createdAt    DateTime               @default(now()) @map("created_at")
  lastLoginAt  DateTime               @default(now()) @map("last_login_at")
  sessions     UserSession[]
  ingestTokens IngestToken[]
  analyses     Analysis[]
  history      VisualizationHistory[]

  @@map("app_user")
}

model UserSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  accessTokenHash  String   @unique @map("access_token_hash")
  refreshTokenHash String   @unique @map("refresh_token_hash")
  accessExpiresAt  DateTime @map("access_expires_at")
  refreshExpiresAt DateTime @map("refresh_expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_session")
}

model IngestToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  tokenHash  String    @unique @map("token_hash")
  tokenHint  String    @map("token_hint")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("ingest_token")
}

model Analysis {
  id            String                 @id @default(uuid()) @db.Uuid
  userId        String                 @map("user_id") @db.Uuid
  sourceId      String                 @map("source_id")
  traceId       String                 @map("trace_id")
  schemaVersion String                 @map("schema_version")
  startedAt     DateTime               @map("started_at")
  endedAt       DateTime               @map("ended_at")
  stages        Json
  techniques    Json
  confidence    Float
  evidence      Json
  rawTrace      Json                   @map("raw_trace")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  events        AnalysisEvent[]
  history       VisualizationHistory[]

  @@unique([userId, sourceId, traceId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, traceId])
  @@map("analysis")
}

model AnalysisEvent {
  id         BigInt   @id @default(autoincrement())
  analysisId String   @map("analysis_id") @db.Uuid
  eventId    String   @map("event_id")
  sequence   BigInt
  eventType  String   @map("event_type")
  timestamp  DateTime @map("event_timestamp")
  data       Json     @map("event_data")
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([analysisId, eventId])
  @@index([analysisId, sequence])
  @@map("analysis_event")
}

model VisualizationHistory {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id") @db.Uuid
  analysisId String   @map("analysis_id") @db.Uuid
  action     String
  metadata   Json
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("visualization_history")
}
